# ─────────────────────────────────────────────────────────────────────
# SALIN KE .env LALU ISI.  JANGAN PERNAH COMMIT .env
#
# Bila berkas .env TIDAK ADA, ./jalankan-web.sh berjalan di mode LOKAL
# (Anvil). Isi berkas ini hanya bila ingin memakai jaringan sungguhan.
# ─────────────────────────────────────────────────────────────────────

# ── Jaringan ─────────────────────────────────────────────────────────
# Contoh: Monad Testnet
NAMA_JARINGAN=monad-testnet
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz/
# Dipakai peramban untuk verifikasi mandiri — WAJIB tanpa API key,
# karena URL ini terlihat oleh semua pengunjung.
RPC_URL_PUBLIK=https://testnet-rpc.monad.xyz/

# Contoh lain:
#   Base Sepolia : CHAIN_ID=84532  RPC_URL=https://sepolia.base.org
#   Polygon Amoy : CHAIN_ID=80002  RPC_URL=https://rpc-amoy.polygon.technology

# Diisi otomatis oleh ./deploy-jaringan.sh
ALAMAT_REGISTRI=

# Kosongkan agar tautan hash mengarah ke block explorer asli jaringan.
# Isi "/explorer" hanya untuk jaringan yang tidak punya explorer publik.
EXPLORER_URL=

# ── Kunci (plan.md 15.3) — TIGA kunci TERPISAH, semuanya secp256k1 ────
# Dompet pengirim transaksi. Buat baru: cast wallet new
# Lebih aman: kosongkan ini, pakai keystore Foundry ->
#   cast wallet import penerbit --interactive
#   AKUN=penerbit ./deploy-jaringan.sh
KUNCI_TX=

# Alamat penandatangan dokumen kredensial (BUKAN rahasia).
# Diisi otomatis oleh ./deploy-jaringan.sh bila dikosongkan.
ALAMAT_PENERBIT=

# ── Aplikasi ─────────────────────────────────────────────────────────
BASE_URL=http://localhost:5173
AMBANG_SALDO_WALLET=0.05
