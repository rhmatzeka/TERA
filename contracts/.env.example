# SALIN KE .env LALU ISI. JANGAN PERNAH COMMIT .env
#
# Cara paling aman: JANGAN isi KUNCI_TX sama sekali, pakai keystore:
#   cast wallet import penerbit-testnet --interactive
#   forge script script/Deploy.s.sol --rpc-url $RPC_URL --account penerbit-testnet --broadcast

# Dompet pengirim transaksi. HANYA dompet sekali pakai berisi dana faucet.
# Buat baru dengan: cast wallet new
KUNCI_TX=

# Alamat penandatangan dokumen kredensial (BUKAN rahasia, hanya alamat)
ALAMAT_PENERBIT=

# Jaringan
RPC_URL=
